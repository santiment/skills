# Compiled binaries (anchored to repo root so cmd/score/ is not ignored)
/bin/
/dist/
/score

# Runtime cache of the score binary materialized by the skill's run.sh wrapper
skills/score/scripts/.bin/

# Generated, normalized OpenAPI specs (produced by `task gen`)
api/specs/*.normalized.json

# Local config / credentials caches
*.local.yaml
.env

# Go
*.test
*.out
coverage.*

# Editors
.idea/
.vscode/

# Runtime cache of the hyperhandler binary materialized by the skill's run.sh wrapper
skills/hyperhandler/scripts/.bin/
